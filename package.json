{
  "name": "ciee-curriculos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F backend --",
    "db:studio": "turbo run db:studio -F backend --",
    "db:generate": "turbo run db:generate -F backend --",
    "db:migrate": "turbo run db:migrate -F backend --",
    "db:start": "docker compose up -d sqlserver",
    "db:watch": "docker compose up sqlserver",
    "db:stop": "docker compose stop sqlserver",
    "db:down": "docker compose down sqlserver",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ciee-curriculos/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0"
  },
  "packageManager": "pnpm@11.8.0"
}
