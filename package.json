{
  "name": "ciee-curriculos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ciee-curriculos/shared build && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "dev:web": "pnpm --filter @ciee-curriculos/shared build && turbo run dev -F web --",
    "dev:backend": "pnpm --filter @ciee-curriculos/shared build && turbo run dev -F backend --",
    "prisma:generate": "turbo run prisma:generate -F backend --",
    "prisma:format": "turbo run prisma:format -F backend --",
    "prisma:push": "turbo run prisma:push -F backend --",
    "prisma:studio": "turbo run prisma:studio -F backend --",
    "prisma:migrate": "turbo run prisma:migrate -F backend --",
    "prisma:migrate:deploy": "turbo run prisma:migrate:deploy -F backend --",
    "db:start": "docker compose --env-file apps/backend/.env up -d sqlserver",
    "db:watch": "docker compose --env-file apps/backend/.env up sqlserver",
    "db:stop": "docker compose --env-file apps/backend/.env stop sqlserver",
    "db:down": "docker compose --env-file apps/backend/.env down sqlserver",
    "docker:build": "docker compose --env-file apps/backend/.env build",
    "docker:up": "docker compose --env-file apps/backend/.env up -d --build",
    "docker:down": "docker compose --env-file apps/backend/.env down",
    "docker:logs": "docker compose --env-file apps/backend/.env logs -f",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ciee-curriculos/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0"
  },
  "packageManager": "pnpm@11.8.0"
}
