# Server
PORT=3000
NODE_ENV=development
# Comma-separated browser origins; whitespace and trailing slashes are normalized
CORS_ORIGIN=http://localhost:3001
# Comma-separated trusted reverse proxy IP addresses or CIDRs
TRUSTED_PROXY_IPS=

# Database
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=backend_db
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=DevOnly_Strong_Password_2026!X9
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# RustFS / S3-compatible object storage (development defaults)
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_PUBLIC=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfs_user
S3_SECRET_KEY=rustfs_password_secure
S3_BUCKET=curricula
