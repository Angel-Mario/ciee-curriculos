generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlserver"
}

model Todo {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  description String?
  completed   Boolean  @default(false)

  @@map("todo")
}
